    "node:tty": "./webui/shims/nodeBuiltins.js",
    "url": "./webui/shims/url.js",
    "node:url": "./webui/shims/url.js",
    "util": "./webui/shims/nodeBuiltins.js",
    "node:util": "./webui/shims/nodeBuiltins.js",
    "util/types": "./webui/shims/nodeBuiltins.js",
    "node:util/types": "./webui/shims/nodeBuiltins.js",
    "v8": "./webui/shims/nodeBuiltins.js",
    "node:v8": "./webui/shims/nodeBuiltins.js",
    "worker_threads": "./webui/shims/nodeBuiltins.js",
    "node:worker_threads": "./webui/shims/nodeBuiltins.js",
    "zlib": "./webui/shims/nodeBuiltins.js",
    "node:zlib": "./webui/shims/nodeBuiltins.js",
    "node:sqlite": "./webui/shims/nodeBuiltins.js",
