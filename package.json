    "perf_hooks": "./webui/shims/nodeBuiltins.js",
    "node:perf_hooks": "./webui/shims/nodeBuiltins.js",
    "process": "./webui/shims/process.js",
    "node:process": "./webui/shims/process.js",
    "querystring": "./webui/shims/nodeBuiltins.js",
    "node:querystring": "./webui/shims/nodeBuiltins.js",
    "readline": "./webui/shims/nodeBuiltins.js",
    "node:readline": "./webui/shims/nodeBuiltins.js",
    "react-compiler-runtime": "./webui/shims/nodeBuiltins.js",
    "react/compiler-runtime": "./webui/shims/nodeBuiltins.js",
    "stream": "./webui/shims/nodeBuiltins.js",
    "node:stream": "./webui/shims/nodeBuiltins.js",
    "stream/promises": "./webui/shims/nodeBuiltins.js",
    "node:stream/promises": "./webui/shims/nodeBuiltins.js",
    "stream/web": "./webui/shims/nodeBuiltins.js",
