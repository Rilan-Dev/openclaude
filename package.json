    "react-dom/client": "./webui/shared/react-dom-client.browser.js",
    "react-dom/server": "./webui/shared/react-dom-server.browser.js",
    "./src/utils/auth.js": "./webui/shims/auth.js",
    "./src/utils/auth.ts": "./webui/shims/auth.js",
    "child_process": "./webui/shims/nodeBuiltins.js",
    "node:child_process": "./webui/shims/nodeBuiltins.js",
    "crypto": "./webui/shims/nodeBuiltins.js",
