    "node:fs": "./webui/shims/nodeBuiltins.js",
    "fs/promises": "./webui/shims/nodeBuiltins.js",
    "node:fs/promises": "./webui/shims/nodeBuiltins.js",
    "http": "./webui/shims/nodeBuiltins.js",
