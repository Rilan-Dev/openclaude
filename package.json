    "react-reconciler": "0.33.0",
    "semver": "7.8.5",
    "sharp": "^0.35.2",
    "shell-quote": "^1.8.4",
    "signal-exit": "4.1.0",
    "supports-hyperlinks": "4.5.0",
    "tree-kill": "1.2.2",
    "turndown": "7.2.4",
    "type-fest": "5.7.0",
    "undici": "^8.5.0",
    "usehooks-ts": "3.1.1",
    "vscode-languageserver-protocol": "3.18.1",
    "wrap-ansi": "10.0.0",
