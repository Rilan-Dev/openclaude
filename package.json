    "@ant/claude-for-chrome-mcp": "./webui/shims/optionalPackages.js",
    "@anthropic-ai/sandbox-runtime": "./webui/shims/sandboxRuntime.js",
    "@anthropic-ai/mcpb": "./webui/shims/optionalPackages.js",
    "@aws-sdk/client-bedrock": "./webui/shims/optionalPackages.js",
    "@aws-sdk/client-bedrock-runtime": "./webui/shims/optionalPackages.js",
    "@aws-sdk/client-sts": "./webui/shims/optionalPackages.js",
    "@aws-sdk/credential-provider-ini": "./webui/shims/optionalPackages.js",
    "@aws-sdk/credential-provider-login": "./webui/shims/optionalPackages.js",
    "@aws-sdk/credential-provider-login/dist-es/LoginCredentialsFetcher.js": "./webui/shims/optionalPackages.js",
    "@aws-sdk/credential-provider-login/dist-es/fromLoginCredentials.js": "./webui/shims/optionalPackages.js",
    "@aws-sdk/credential-provider-node": "./webui/shims/optionalPackages.js",
    "@aws-sdk/credential-providers": "./webui/shims/optionalPackages.js",
    "@aws-sdk/credential-providers/dist-es/fromLoginCredentials.js": "./webui/shims/optionalPackages.js",
    "@smithy/core": "./webui/shims/optionalPackages.js",
    "@smithy/node-http-handler": "./webui/shims/optionalPackages.js",
    "env-paths": "./webui/shims/envPaths.js",
    "execa": "./webui/shims/execa.js",
    "has-flag": "./webui/shims/hasFlag.js",
    "https-proxy-agent": "./webui/shims/httpsProxyAgent.js",
    "is-unicode-supported": "./webui/shims/isUnicodeSupported.js",
    "sharp": "./webui/shims/sharp.js",
    "supports-hyperlinks": "./webui/shims/supportsHyperlinks.js",
    "node-fetch": "./webui/shims/nodeFetch.js",
    "fetch-blob/from.js": "./webui/shims/fetchBlob.js",
    "undici": "./webui/shims/undici.js",
    "vscode-jsonrpc/node.js": "./webui/shims/optionalPackages.js"
