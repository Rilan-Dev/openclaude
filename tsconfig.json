{
  "compilerOptions": {
    "target": "ES2023",
    "lib": ["ES2023", "DOM"],
    "module": "ESNext",
    "moduleResolution": "bundler",
    "jsx": "react-jsx",
    "strict": true,
    "noImplicitAny": false,
    "noEmit": true,
    "allowImportingTsExtensions": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "resolveJsonModule": true,
    "declaration": false,
    "outDir": "./dist",
    "rootDir": "./src",
    "ignoreDeprecations": "6.0",
    "baseUrl": ".",
    "types": ["bun", "node"],
    "paths": {
      "@/*": ["./src/*"],
      "react": ["./webui/shared/react.browser.ts"],
      "react/jsx-runtime": ["./webui/shared/react-jsx-runtime.browser.ts"],
      "react/jsx-dev-runtime": ["./webui/shared/react-jsx-dev-runtime.browser.ts"],
      "react-dom": ["./webui/shared/react-dom.browser.ts"],
      "react-dom/client": ["./webui/shared/react-dom-client.browser.ts"],
      "react-dom/server": ["./webui/shared/react-dom-server.browser.ts"]
    }
  },
  "include": ["src/**/*"],
  "exclude": ["node_modules", "dist"]
}
