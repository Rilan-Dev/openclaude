{
  "compilerOptions": {
    "target": "ES2020",
    "useDefineForClassFields": true,
    "lib": ["ES2020", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "skipLibCheck": true,
    "moduleResolution": "bundler",
    "allowImportingTsExtensions": true,
    "resolveJsonModule": true,
    "isolatedModules": true,
    "noEmit": true,
    "jsx": "react-jsx",
    "strict": true,
    "baseUrl": ".",
    "paths": {
      "@/*": ["../src/*"],
      "@web/*": ["./src/*"],
      "react": ["./shared/react.browser.ts"],
      "react/jsx-runtime": ["./shared/react-jsx-runtime.browser.ts"],
      "react/jsx-dev-runtime": ["./shared/react-jsx-dev-runtime.browser.ts"],
      "react-dom": ["./shared/react-dom.browser.ts"],
      "react-dom/client": ["./shared/react-dom-client.browser.ts"],
      "react-dom/server": ["./shared/react-dom-server.browser.ts"],
      "bun:bundle": ["../src/optionalModules.d.ts"]
    }
  },
  "include": ["src", "../src", "../src/optionalModules.d.ts"],
  "references": [{ "path": "./tsconfig.node.json" }]
}
